<arg_key>content</arg_key><arg_value>//! Schematic sheet definitions for hierarchical designs.

use serde::{Deserialize, Serialize};

/// A single schematic sheet in a hierarchical design.
#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct Sheet {
    pub id: uuid::Uuid,
    pub name: String,
    pub parent: Option<uuid::Uuid>,
    pub children: Vec<uuid::Uuid>,
    pub components: Vec<uuid::Uuid>,
    pub wires: Vec<Wire>,
    pub labels: Vec<Label>,
}

/// A wire connecting two points on a schematic sheet.
#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct Wire {
    pub id: uuid::Uuid,
    pub points: Vec<WirePoint>,
}

/// A point on a wire.
#[derive(Debug, Clone, Copy, Default, Serialize, Deserialize)]
pub struct WirePoint {
    pub x: f64,
    pub y: f64,
}

/// A label on a schematic sheet (net naming).
#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct Label {
    pub id: uuid::Uuid,
    pub name: String,
    pub label_type: LabelType,
    pub position: LabelPosition,
}

/// Type of label.
#[derive(Debug, Clone, Copy, Default, Serialize, Deserialize)]
pub enum LabelType {
    Local,
    Global,
    Hierarchical,
    Power,
}

/// Position of a label on a schematic sheet.
#[derive(Debug, Clone, Copy, Default, Serialize, Deserialize)]
pub struct LabelPosition {
    pub x: f64,
    pub y: f64,
    pub rotation: f64,
}</arg_value>

